# .gitignore を作成して不要なフォルダやファイルを登録
@"
# 仮想環境
.venv/
venv/
ENV/

# Pythonのキャッシュ
__pycache__/
*.py[cod]
*$py.class

# 環境変数・シークレット
.env
.env.local

# VS Code / IDE 設定
.vscode/
.idea/

# OS生成ファイル
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 音声一時ファイルやビルド成果物
*.wav
*.mp3
build/
dist/
*.spec
"@ | Out-File -Encoding utf8 .gitignore